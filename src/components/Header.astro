---
const { path } = Astro.props;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<header class="site-header">
  <div class="max-w-[720px] mx-auto px-3 sm:px-0 pt-3 pb-1 sm:pt-4 sm:pb-2 flex items-center justify-center gap-3 sm:gap-6">
    <div class="brand-cluster">
      <span class="cs-status-led" aria-label="System status" title="System status"></span>
      <a href="/" class="brand-mark" aria-label="Jordan Newell — home">
        <img
          src="/images/coming-soon/newell-wordmark.png"
          alt="Newell"
          width="839"
          height="153"
          decoding="async"
        />
      </a>
    </div>
  </div>
</header>

<style>
  .brand-cluster {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    line-height: 0;
  }
  /* Status LED — premium indicator lamp. Layered radial gradient for
     3D sphere depth, glossy highlight via ::before for glass-lens feel,
     dark housing ring around it (like a real panel-mount LED). */
  .cs-status-led {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    position: relative;
    flex-shrink: 0;
    background:
      radial-gradient(circle at 30% 28%,
        #b8ffba 0%,
        #5fff66 22%,
        #3FFF46 55%,
        #1f8a23 100%);
    box-shadow:
      /* Outer halo */
      0 0 6px rgba(63, 255, 70, 0.55),
      0 0 14px rgba(63, 255, 70, 0.3),
      /* Top inner highlight */
      inset 0 1px 1px rgba(255, 255, 255, 0.6),
      /* Bottom inner recess */
      inset 0 -1.5px 2px rgba(0, 0, 0, 0.45),
      /* Housing rings — dark bezel */
      0 0 0 1.5px #181818,
      0 0 0 2.5px #050505,
      /* Drop shadow under housing */
      0 1px 2px rgba(0, 0, 0, 0.6);
    transition: background 0.5s ease, box-shadow 0.5s ease;
  }
  /* Glass-lens specular highlight — small white reflection top-left */
  .cs-status-led::before {
    content: "";
    position: absolute;
    top: 1.5px;
    left: 2.5px;
    width: 4px;
    height: 3px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.75);
    filter: blur(0.4px);
    pointer-events: none;
  }
  body.cs-powered-off .cs-status-led {
    background:
      radial-gradient(circle at 30% 28%,
        #ffb8b8 0%,
        #ff7070 22%,
        #ff4040 55%,
        #8a1f1f 100%);
    animation: cs-status-pulse 1.8s ease-in-out infinite;
  }
  @keyframes cs-status-pulse {
    0%, 100% {
      box-shadow:
        0 0 5px rgba(255, 64, 64, 0.45),
        0 0 12px rgba(255, 64, 64, 0.22),
        inset 0 1px 1px rgba(255, 255, 255, 0.55),
        inset 0 -1.5px 2px rgba(0, 0, 0, 0.45),
        0 0 0 1.5px #181818,
        0 0 0 2.5px #050505,
        0 1px 2px rgba(0, 0, 0, 0.6);
    }
    50% {
      box-shadow:
        0 0 10px rgba(255, 64, 64, 0.9),
        0 0 22px rgba(255, 64, 64, 0.55),
        inset 0 1px 1px rgba(255, 255, 255, 0.65),
        inset 0 -1.5px 2px rgba(0, 0, 0, 0.45),
        0 0 0 1.5px #181818,
        0 0 0 2.5px #050505,
        0 1px 2px rgba(0, 0, 0, 0.6);
    }
  }
  .brand-mark {
    display: inline-flex;
    align-items: center;
    line-height: 0;
    text-decoration: none;
  }
  .brand-mark img {
    display: block;
    height: 24px;
    width: auto;
    transition: filter 0.5s ease, opacity 0.5s ease;
  }
  .brand-mark:hover img {
    filter: drop-shadow(0 0 6px color-mix(in srgb, var(--color-green) 60%, transparent));
  }
  /* When system is OFF, the wordmark dims to a ghost. Only the status
     LED + power knob remain as beacons. */
  body.cs-powered-off .brand-mark img {
    opacity: 0.15;
    filter: brightness(0.4) grayscale(0.5);
  }
  @media (min-width: 640px) {
    .brand-cluster { gap: 14px; }
    .brand-mark img { height: 34px; }
  }
</style>
