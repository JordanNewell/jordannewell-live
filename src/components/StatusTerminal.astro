---
// Status terminal — live GitHub activity panel.
// Body is populated client-side by /js/status-hero.js.
// When `embedded` is true (inside Workstation), the bar + foot are hidden
// because the parent chassis provides its own status chrome.
const { embedded = false } = Astro.props;
const year = new Date().getFullYear();
---

<section class={`terminal ${embedded ? "terminal-embedded" : ""}`} aria-label="Live activity" data-terminal>
  {/* N mark watermark — centered behind terminal body content, visible
      through scanlines. Sits in the .terminal parent so it doesn't scroll
      with the body's content. pointer-events:none keeps it from blocking
      text selection or link clicks inside the terminal. */}
  <img
    class="terminal-watermark"
    src="/images/jordan-portrait.png?v=1"
    alt=""
    aria-hidden="true"
  />
  {embedded ? null : (
    <header class="terminal-bar">
      <div class="terminal-socials">
        <a href="https://github.com/jordannewell" target="_blank" rel="noopener" aria-label="GitHub" title="GitHub">
          <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0016 8c0-4.42-3.58-8-8-8z" />
          </svg>
        </a>
      </div>
      <div class="terminal-pulse" aria-hidden="true">
        <span class="terminal-pulse-dot"></span>
        <span class="terminal-pulse-text">live</span>
      </div>
      <div class="terminal-x">
        <a href="https://x.com/newellops" target="_blank" rel="noopener" aria-label="X (@newellops)" title="X (@newellops)">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
          </svg>
        </a>
      </div>
    </header>
  )}

  <div class="terminal-body" data-terminal-body>
    <div class="terminal-line">
      <span class="terminal-prompt">$</span>
      <span class="terminal-cmd">newell --log</span>
    </div>
    <div class="terminal-line terminal-muted" data-terminal-status>connecting to github…</div>
  </div>

  {embedded ? null : (
    <footer class="terminal-foot">
      © {year} <a href="/">Jordan Newell</a> <span aria-hidden="true">⚡</span> <a href="/legal">license</a>
    </footer>
  )}
</section>

<style>
  .terminal {
    width: 100%;
    max-width: 720px;
    background: #000;
    border: 1px solid color-mix(in srgb, var(--color-green) 25%, var(--color-border));
    box-shadow: 0 0 24px color-mix(in srgb, var(--color-green) 10%, transparent),
                inset 0 0 0 1px color-mix(in srgb, var(--color-green) 5%, transparent);
    font-family: var(--font-mono);
    overflow: hidden;
    position: relative;
  }
  /* N mark watermark — centered behind the body, hidden behind the bar
     (which has its own bg). pointer-events:none so it never blocks clicks. */
  .terminal-watermark {
    position: absolute;
    bottom: 22px;
    left: 50%;
    transform: translateX(-50%);
    width: 440px;
    height: auto;
    opacity: 0.13;
    pointer-events: none;
    user-select: none;
    z-index: 0;
    filter: drop-shadow(0 0 12px rgba(63, 255, 70, 0.2));
  }
  .terminal-bar,
  .terminal-body,
  .terminal-foot {
    position: relative;
    z-index: 1;
  }
  /* Embedded mode (inside Workstation chassis) — strip the chrome,
     fill the CRT glass, use CRT-green text. */
  .terminal.terminal-embedded {
    max-width: none;
    border: none;
    background: transparent;
    box-shadow: none;
  }
  .terminal.terminal-embedded .terminal-body {
    padding: 10px 14px 14px;
    min-height: 120px;
    max-height: 180px;
    color: #5fff66;
    text-shadow: 0 0 4px rgba(63, 255, 70, 0.35);
  }

  .terminal-bar {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 8px 14px;
    background: color-mix(in srgb, var(--color-green) 5%, #000);
    border-bottom: 1px solid color-mix(in srgb, var(--color-green) 15%, var(--color-border));
  }

  /* GH on the left, X on the right — both flanks carry flex:1 so the pulse
     stays perfectly centered regardless of icon widths. */
  .terminal-socials,
  .terminal-x {
    display: inline-flex;
    align-items: center;
    flex: 1;
    color: var(--color-fg);
  }
  .terminal-socials {
    justify-content: flex-start;
  }
  .terminal-x {
    justify-content: flex-end;
  }
  .terminal-socials a,
  .terminal-x a {
    display: inline-flex;
    align-items: center;
    line-height: 0;
    color: inherit;
    text-decoration: none;
    transition: color 0.15s ease, filter 0.15s ease;
  }
  .terminal-socials a:hover,
  .terminal-x a:hover {
    color: var(--color-green);
    filter: drop-shadow(0 0 4px color-mix(in srgb, var(--color-green) 50%, transparent));
  }
  .terminal-pulse {
    flex: 0 0 auto;
  }
  /* Mobile: tighten the bar — single GH + pulse + X layout. */
  @media (max-width: 600px) {
    .terminal-bar { gap: 8px; padding: 8px 10px; }
  }

  .terminal-foot {
    padding: 6px 14px 8px;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.06em;
    color: var(--color-fg-muted);
    border-top: 1px dashed color-mix(in srgb, var(--color-green) 12%, transparent);
    text-align: center;
  }
  .terminal-foot a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px dotted color-mix(in srgb, var(--color-green) 30%, transparent);
  }
  .terminal-foot a:hover {
    color: var(--color-green);
    border-bottom-color: var(--color-green);
  }

  .terminal-title {
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    color: var(--color-fg-muted);
    flex: 1;
    text-align: center;
  }

  .terminal-pulse {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.62rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-green);
  }
  .terminal-pulse-dot {
    width: 6px;
    height: 6px;
    background: var(--color-green);
    border-radius: 50%;
    box-shadow: 0 0 6px var(--color-green);
    animation: terminal-blink 2s ease-in-out infinite;
  }
  .terminal-pulse-text { opacity: 0.8; }

  @keyframes terminal-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  .terminal-body {
    padding: 14px 18px 16px;
    height: 500px;
    overflow-y: auto;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-fg-secondary);
    display: flex;
    flex-direction: column;
    gap: 4px;
    scrollbar-width: none;
    scrollbar-color: transparent transparent;
    transition: scrollbar-color 0.2s ease;
    /* Faint CRT scanlines — reinforces live-monitor metaphor, ~3% opacity. */
    background-image: repeating-linear-gradient(
      0deg,
      rgba(255, 255, 255, 0.03) 0px,
      rgba(255, 255, 255, 0.03) 1px,
      transparent 1px,
      transparent 3px
    );
  }
  /* Reveal scrollbar only when actively scrolling or hovering */
  .terminal-body:hover,
  .terminal-body:focus-within {
    scrollbar-color: rgba(63, 255, 70, 0.55) transparent;
  }
  .terminal-body::-webkit-scrollbar { width: 0; transition: width 0.2s ease; }
  .terminal-body:hover::-webkit-scrollbar,
  .terminal-body:focus-within::-webkit-scrollbar { width: 4px; }
  .terminal-body::-webkit-scrollbar-track { background: transparent; }
  .terminal-body::-webkit-scrollbar-thumb {
    background: linear-gradient(180deg,
      rgba(63, 255, 70, 0.7) 0%,
      rgba(63, 255, 70, 0.4) 50%,
      rgba(250, 250, 250, 0.4) 100%);
    border-radius: 2px;
    box-shadow: 0 0 4px rgba(63, 255, 70, 0.4);
  }
  .terminal-body::-webkit-scrollbar-thumb:hover {
    background: linear-gradient(180deg,
      #3FFF46 0%,
      rgba(63, 255, 70, 0.6) 50%,
      #fafafa 100%);
  }

  .terminal-line {
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
    word-break: break-word;
  }

  .terminal-prompt {
    color: var(--color-green);
    font-weight: 700;
  }
  .terminal-cmd {
    color: var(--color-fg);
  }
  .terminal-muted {
    color: var(--color-fg-muted);
  }

  /* Rows injected by JS */
  :global(.terminal-row) {
    display: flex;
    align-items: baseline;
    gap: 8px;
    padding: 2px 0;
    flex-wrap: wrap;
    word-break: break-word;
  }
  :global(.terminal-row-sha) {
    color: var(--color-green);
    font-size: 0.72rem;
  }
  :global(.terminal-row-repo) {
    color: var(--color-fg-muted);
    font-size: 0.7rem;
  }
  :global(.terminal-row-msg) {
    color: var(--color-fg);
    flex: 1;
    min-width: 0;
  }
  :global(.terminal-row-time) {
    color: var(--color-fg-muted);
    font-size: 0.68rem;
    margin-left: auto;
  }
  :global(.terminal-row a) {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px dotted color-mix(in srgb, var(--color-green) 40%, transparent);
    transition: border-color 0.15s, color 0.15s;
  }
  :global(.terminal-row a:hover) {
    color: var(--color-green);
    border-bottom-color: var(--color-green);
  }

  :global(.terminal-section-label) {
    color: var(--color-fg-muted);
    font-size: 0.65rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin-top: 10px;
    margin-bottom: 2px;
    padding-bottom: 2px;
    border-bottom: 1px dashed color-mix(in srgb, var(--color-green) 15%, transparent);
  }
  :global(.terminal-section-label:first-child) {
    margin-top: 4px;
  }
</style>
