---
// Bottom-left emoji dock. Only ✨ is visible at rest — click it and a vertical
// drawer pops up containing all the link emojis. Scales to any count.
// Pure HTML <details> + <summary> — no JS, keyboard accessible.
---

<div class="dock-container">
  <details class="dock-details">
    <summary class="dock-link dock-trigger" aria-label="Open links menu" title="Links">
      <img src="/images/nmojibutton.png?v=1" alt="" aria-hidden="true" class="dock-trigger-img" width="80" height="80" decoding="async" />
    </summary>
    <div class="dock-drawer dock-drawer-up">
      <a class="dock-link drawer-link" href="mailto:hello@jordannewell.com" aria-label="Say hello" title="Say hello">
        <span aria-hidden="true">💬</span>
      </a>
      <a class="dock-link drawer-link" href="https://buymeacoffee.com/jordannewell" target="_blank" rel="noopener" aria-label="Buy me a coffee" title="Buy me a coffee">
        <span aria-hidden="true">☕</span>
      </a>
      <a class="dock-link drawer-link" href="https://github.com/sponsors/JordanNewell" target="_blank" rel="noopener" aria-label="Sponsor on GitHub" title="Sponsor on GitHub">
        <span aria-hidden="true">💚</span>
      </a>
    </div>
    <div class="dock-drawer dock-drawer-side">
      <a class="dock-link drawer-link" href="https://community.obsidian.md/plugins/curtis-ai-chat" target="_blank" rel="noopener" aria-label="Curtis AI" title="Curtis AI">
        <img src="/images/curtis-ai-logo.png?v=1" alt="" class="drawer-emoji-img" decoding="async" />
      </a>
      <a class="dock-link drawer-link" href="https://github.com/JordanNewell/harbormasterd" target="_blank" rel="noopener" aria-label="Harbormasterd" title="Harbormasterd">
        <img src="/images/harbor-logo.png?v=1" alt="" class="drawer-emoji-img" decoding="async" />
      </a>
      <a class="dock-link drawer-link" href="https://github.com/JordanNewell/git-hygiene" target="_blank" rel="noopener" aria-label="Git Hygiene" title="Git Hygiene">
        <img src="/images/git-hygiene-logo.png?v=1" alt="" class="drawer-emoji-img" decoding="async" />
      </a>
    </div>
  </details>
</div>

<style>
  /* Static — left-aligned at the bottom of the .cs flex column. */
  .dock-container {
    width: 100%;
    max-width: 720px;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    margin-top: auto;
    margin-left: -20px;
    padding: 0 4px;
    transform: translateY(10px);
  }
  /* Desktop: push the trigger further into the left corner — content column
     is centered, so negative margin eats into the surrounding viewport void. */
  @media (min-width: 769px) {
    .dock-container {
      margin-left: -120px;
    }
  }
  .dock-details {
    position: relative;
    display: inline-flex;
    align-items: center;
  }
  .dock-link {
    text-decoration: none;
    font-size: 30px;
    line-height: 1;
    opacity: 0.85;
    transition: opacity 0.18s ease,
                transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1),
                filter 0.18s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 40px;
    min-height: 40px;
    cursor: pointer;
  }
  .dock-link:hover {
    opacity: 1;
    transform: scale(1.3) translateY(-3px);
    filter: drop-shadow(0 0 8px rgba(63, 255, 70, 0.25));
  }
  .dock-link:active {
    transform: scale(1.15) translateY(-1px);
  }
  /* Strip default disclosure triangle so "Details" never leaks. */
  .dock-trigger {
    list-style: none;
    padding: 0;
  }
  .dock-trigger::-webkit-details-marker {
    display: none;
  }
  .dock-trigger-img {
    width: 80px;
    height: 80px;
    display: block;
    transition: filter 0.18s ease;
  }
  /* Base drawer — invisible/collapsed by default. Two variants:
     .dock-drawer-up pops vertically above the trigger (regular emojis).
     .dock-drawer-side pops horizontally to the left (image emojis). */
  .dock-drawer {
    position: absolute;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.22s ease,
                transform 0.22s cubic-bezier(0.34, 1.56, 0.64, 1),
                visibility 0s linear 0.22s;
    z-index: 60;
  }
  .dock-drawer-up {
    bottom: calc(100% + 4px);
    left: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding: 8px 0;
    transform: translateX(-50%) translateY(10px) scale(0.95);
    transform-origin: bottom center;
  }
  .dock-drawer-side {
    left: calc(100% + 8px);
    top: 50%;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 14px;
    padding: 0 8px;
    transform: translateY(-50%) translateX(-10px) scale(0.95);
    transform-origin: left center;
  }
  .dock-details[open] .dock-drawer-up {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0) scale(1);
    pointer-events: auto;
  }
  .dock-details[open] .dock-drawer-side {
    opacity: 1;
    visibility: visible;
    transform: translateY(-50%) translateX(0) scale(1);
    pointer-events: auto;
  }
  /* Dock on LEFT: side-drawer opens rightward (toward page center). */
  .dock-details[open] .dock-drawer-up,
  .dock-details[open] .dock-drawer-side {
    transition: opacity 0.22s ease,
                transform 0.22s cubic-bezier(0.34, 1.56, 0.64, 1),
                visibility 0s linear 0s;
  }
  .drawer-link {
    font-size: 32px;
    min-width: 48px;
    min-height: 48px;
  }
  .drawer-emoji-img {
    width: 38px;
    height: 38px;
    display: block;
  }
  /* Trigger flourish when open: rotate + subtle glow so it reads as "active". */
  .dock-details[open] .dock-trigger {
    transform: rotate(90deg) scale(1.15);
    opacity: 1;
    filter: drop-shadow(0 0 8px rgba(63, 255, 70, 0.3));
  }
  @media (max-width: 768px) {
    .dock-container {
      padding: 10px 4px 0;
      transform: translateY(-40px);
    }
    .dock-link {
      font-size: 26px;
      min-width: 34px;
      min-height: 34px;
    }
    .dock-trigger {
      font-size: 28px;
    }
    .drawer-link {
      font-size: 28px;
      min-width: 40px;
      min-height: 40px;
    }
    .dock-drawer {
      padding: 8px 4px;
      gap: 8px;
    }
  }
</style>
