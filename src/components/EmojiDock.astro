---
// Bottom-right N mark — decorative, no link.
---
<img
  src="/images/nmojibutton.png?v=1"
  alt=""
  aria-hidden="true"
  class="dock-trigger-img"
  width="80"
  height="80"
  decoding="async"
/>

<style>
  .dock-trigger-img {
    position: fixed;
    right: 16px;
    bottom: 16px;
    display: block;
    z-index: 9999;
    width: 64px;
    height: 64px;
    opacity: 0.9;
    filter: drop-shadow(0 6px 12px rgba(0, 0, 0, 0.5));
    transition: opacity 0.18s ease;
    line-height: 0;
  }
  .dock-trigger-img:hover { opacity: 1; }
  @media (max-width: 768px) {
    .dock-trigger-img {
      width: 48px;
      height: 48px;
      right: 12px;
      bottom: 12px;
    }
  }
</style>
