---
// Bottom-left N mark — fixed overlay, mirrors the PFP. Static, no interaction.
---

<img
  src="/images/nmojibutton.png?v=1"
  alt=""
  aria-hidden="true"
  class="dock-trigger-img"
  width="80"
  height="80"
  decoding="async"
/>

<style>
  .dock-trigger-img {
    position: fixed;
    left: -15px;
    bottom: -25px;
    width: 140px;
    height: auto;
    opacity: 0.85;
    filter: drop-shadow(0 8px 16px rgba(0, 0, 0, 0.55));
    pointer-events: none;
    z-index: 50;
  }
  @media (max-width: 768px) {
    .dock-trigger-img {
      width: 110px;
      left: -5px;
      bottom: -15px;
    }
  }
</style>
