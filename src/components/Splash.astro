<style is:global>
  /* Self-typing JORDANNEWELL — flashes the empty socket green when "typed" */
  .kb-socket.kb-typed {
    fill: #3FFF46 !important;
    filter: drop-shadow(0 0 6px #3FFF46) drop-shadow(0 0 14px rgba(63,255,70,0.5));
    transition: fill 0.06s ease-out, filter 0.06s ease-out;
  }

  /* CRT scanline sweep */
  .kb-scanline {
    position: fixed;
    top: 0; left: 0; right: 0;
    height: 4px;
    background: linear-gradient(to bottom, transparent, #3FFF46 50%, transparent);
    box-shadow: 0 0 24px #3FFF46, 0 0 60px rgba(63,255,70,0.6);
    pointer-events: none;
    z-index: 99999;
    animation: kb-scanline-sweep 0.75s linear forwards;
  }
  @keyframes kb-scanline-sweep {
    from { transform: translateY(-4px); }
    to   { transform: translateY(100vh); }
  }

  /* Scattered letter spin */
  .cs-key.kb-spin {
    animation: kb-letter-spin 0.7s ease-in-out;
  }
  @keyframes kb-letter-spin {
    0%   { transform: rotate(var(--k-rot, 0deg)) scale(1); }
    50%  { transform: rotate(calc(var(--k-rot, 0deg) + 360deg)) scale(1.35); opacity: 1; }
    100% { transform: rotate(calc(var(--k-rot, 0deg) + 720deg)) scale(1); }
  }

  /* Konami Matrix rain overlay */
  .kb-matrix {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.78);
    z-index: 99998;
    pointer-events: none;
    overflow: hidden;
  }
  .kb-matrix-col {
    position: absolute;
    top: -200px;
    font-family: "JetBrains Mono", monospace;
    font-size: 14px;
    line-height: 1.1;
    color: #3FFF46;
    text-shadow: 0 0 6px #3FFF46, 0 0 12px rgba(63,255,70,0.6);
    white-space: pre;
    animation: kb-matrix-fall linear forwards;
  }
  @keyframes kb-matrix-fall {
    from { transform: translateY(0); opacity: 1; }
    to   { transform: translateY(120vh); opacity: 0; }
  }

  /* Konami progress hint — tiny mono caption bottom-center */
  .kb-konami-hint {
    position: fixed;
    bottom: 16px;
    left: 50%;
    transform: translateX(-50%);
    font-family: "JetBrains Mono", monospace;
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    color: #606060;
    background: rgba(0, 0, 0, 0.7);
    border: 1px solid rgba(63, 255, 70, 0.4);
    padding: 6px 12px;
    z-index: 99997;
    pointer-events: none;
    text-shadow: 0 0 6px rgba(63, 255, 70, 0.6);
  }
  .kb-konami-hint .kb-konami-done {
    color: #3FFF46;
    text-shadow: 0 0 8px rgba(63, 255, 70, 0.8);
  }

  /* CRT power button — sits next to NEWELL wordmark in the bottom bar */
  .cs-power-btn {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.7);
    border: 1px solid rgba(63, 255, 70, 0.4);
    color: #3FFF46;
    font-size: 1.1rem;
    cursor: pointer;
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.18s ease;
    text-shadow: 0 0 6px rgba(63, 255, 70, 0.6);
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.4);
  }
  .cs-power-btn:hover {
    background: rgba(63, 255, 70, 0.18);
    box-shadow: 0 0 12px rgba(63, 255, 70, 0.5), 0 0 0 1px rgba(0, 0, 0, 0.4);
  }
  .cs-power-btn:focus-visible {
    outline: 2px solid #3FFF46;
    outline-offset: 2px;
  }
  /* When splash is powered off, brighten + pulse the button so it reads as "press to wake" */
  body.cs-powered-off .cs-power-btn {
    background: rgba(63, 255, 70, 0.25);
    animation: cs-power-pulse 1.8s ease-in-out infinite;
  }
  @keyframes cs-power-pulse {
    0%, 100% { box-shadow: 0 0 16px rgba(63, 255, 70, 0.5), 0 0 0 1px rgba(0, 0, 0, 0.4); }
    50%      { box-shadow: 0 0 28px rgba(63, 255, 70, 0.9), 0 0 0 1px rgba(0, 0, 0, 0.4); }
  }

  /* CRT power-off animation — classic tube TV collapse */
  body.cs-powered-off .cs {
    transform-origin: center center;
    animation: crt-power-off 0.75s cubic-bezier(0.5, 0, 0.5, 1) forwards;
    pointer-events: none;
  }
  body.cs-powered-off::after {
    content: "";
    position: fixed;
    inset: 0;
    background: #000;
    z-index: 99990;
    pointer-events: none;
  }
  .cs {
    transform-origin: center center;
    transition: transform 0.55s cubic-bezier(0.4, 0, 0.4, 1);
  }
  @keyframes crt-power-off {
    0%   { transform: scale(1, 1);     filter: brightness(1); opacity: 1; }
    40%  { transform: scale(1, 0.003); filter: brightness(4) saturate(2); opacity: 1; }
    70%  { transform: scale(1, 0.003); filter: brightness(2); opacity: 1; }
    100% { transform: scale(0.0008, 0.003); filter: brightness(0); opacity: 0; }
  }
</style>

