---
import StatusTerminal from "./StatusTerminal.astro";
import KeyboardBase from "./KeyboardBase.astro";
import EmojiDock from "./EmojiDock.astro";

const now = new Date();
const stamp = now.toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
  timeZone: "UTC",
});

const FONT_URL = "https://jordannewell.github.io/newell-typeface/";

// 12 keys spelling JORDAN NEWELL — split left (JORDAN) / right (NEWELL) gutters.
// Premium keycap look: matte finish, black inner cap, alternating frame colors.
const LEFT = ["J", "O", "R", "D", "A", "N"];
const RIGHT = ["N", "E", "W", "E", "L", "L"];
const keys = [
  // left gutter — JORDAN, pulled inboard to frame the terminal
  { top: "13vh", left: "20vw", rot: -7,  variant: "green" }, // J
  { top: "21vh", left: "24vw", rot:  3,  variant: "white" }, // O
  { top: "28vh", left: "18vw", rot: -3,  variant: "green" }, // R
  { top: "72vh", left: "19vw", rot:  4,  variant: "white" }, // D
  { top: "80vh", left: "24vw", rot: -5,  variant: "green" }, // A
  { top: "88vh", left: "18vw", rot:  2,  variant: "white" }, // N
  // right gutter — NEWELL, mirrored
  { top: "14vh", right: "21vw", rot:  5,  variant: "white" }, // N
  { top: "22vh", right: "25vw", rot: -4,  variant: "green" }, // E
  { top: "29vh", right: "19vw", rot:  6,  variant: "white" }, // W
  { top: "73vh", right: "20vw", rot: -6,  variant: "green" }, // E
  { top: "81vh", right: "25vw", rot:  3,  variant: "white" }, // L
  { top: "89vh", right: "19vw", rot: -2,  variant: "green" }, // L
];
const LETTERS = [...LEFT, ...RIGHT];
---

<section class="cs">
  {keys.map((k, i) => (
    <a
      class={`cs-key cs-key-${k.variant}`}
      href={FONT_URL}
      target="_blank"
      rel="noopener"
      aria-label="Newell typeface — GitHub repo"
      title="Newell typeface — GitHub repo"
      style={`--k-top:${k.top ?? "auto"};--k-right:${k.right ?? "auto"};--k-left:${k.left ?? "auto"};--k-rot:${k.rot}deg;`}
    >
      <span class="cs-key-cap">{LETTERS[i]}</span>
    </a>
  ))}

  <div class="cs-logo-wrap" aria-hidden="true" style="display:none">
    <img
      src="/images/coming-soon/n-mark.png"
      alt=""
      class="cs-logo"
      width="579"
      height="668"
      loading="eager"
      decoding="async"
    />
  </div>

  <StatusTerminal />

  {/* Mechanical keyboard in 3D perspective — desk gradient removed per request. */}
  <div class="cs-keyboard-stage">
    <div class="cs-keyboard">
      <KeyboardBase />
    </div>
  </div>

  {/* Pinned portrait bottom-right — static overlay, no interaction. */}
  <img
    src="/images/jordan-portrait.png?v=4"
    alt=""
    aria-hidden="true"
    class="cs-pfp"
    width="120"
    height="180"
    loading="lazy"
    decoding="async"
  />

  {/* Curtis AI badge bottom-left — mirrors the PFP. Same hover treatment
      (lift + neon green glow), links to the Obsidian plugin page. */}
  <a
    href="https://community.obsidian.md/plugins/curtis-ai-chat"
    target="_blank"
    rel="noopener"
    class="cs-curtis"
    aria-label="Curtis AI"
    title="Curtis AI"
    style="display:none"
  >
    <img src="/images/curtis-ai-corner.png?v=4" alt="Curtis AI" width="155" height="120" loading="lazy" decoding="async" />
  </a>

  {/* Mobile-only key strip — same 12 letters in 2 rows (JORDAN / NEWELL).
      Sits below the terminal as a footer accent. Hidden on >=769px where the
      scattered fixed keycaps take over. */}
  <div class="cs-key-strip" aria-label="Newell typeface keys">
    <div class="cs-strip-word">
      {LEFT.map((letter, i) => (
        <a
          class={`cs-strip-key cs-key-${i % 2 === 0 ? "green" : "white"}`}
          href={FONT_URL}
          target="_blank"
          rel="noopener"
          aria-label="Newell typeface"
          title="Newell typeface"
        >
          <span class="cs-strip-cap">{letter}</span>
        </a>
      ))}
    </div>
    <div class="cs-strip-word">
      {RIGHT.map((letter, i) => (
        <a
          class={`cs-strip-key cs-key-${i % 2 === 0 ? "white" : "green"}`}
          href={FONT_URL}
          target="_blank"
          rel="noopener"
          aria-label="Newell typeface"
          title="Newell typeface"
        >
          <span class="cs-strip-cap">{letter}</span>
        </a>
      ))}
    </div>
  </div>

  {/* "Newell font →" — single link, positioned under the name letters. */}
  <a class="cs-typelink cs-typelink-desktop" href={FONT_URL} target="_blank" rel="noopener" title="Newell font">
    Newell font <span aria-hidden="true">→</span>
  </a>


  {/* NEWELL Stream Deck — product hot keys */}
  <div class="cs-streamdeck" aria-label="NEWELL product family">
    <div class="cs-sd-bezel">
      <div class="cs-sd-grid">
      <a class="cs-sd-key cs-sd-green" href="https://jordannewell.github.io/harbormasterd/" target="_blank" rel="noopener" title="harbormasterd">
        <span class="cs-sd-cap">H</span>
        <span class="cs-sd-label">harbor</span>
      </a>
      <a class="cs-sd-key cs-sd-white" href="https://jordannewell.github.io/claudeway-site/" target="_blank" rel="noopener" title="claudeway">
        <span class="cs-sd-cap">CL</span>
        <span class="cs-sd-label">claudeway</span>
      </a>
      <a class="cs-sd-key cs-sd-green" href="https://github.com/JordanNewell/curtis-ai-chat" target="_blank" rel="noopener" title="curtis-ai-chat">
        <span class="cs-sd-cap">CA</span>
        <span class="cs-sd-label">curtis-ai</span>
      </a>
      <a class="cs-sd-key cs-sd-white" href="https://jordannewell.github.io/curtis-compliance/" target="_blank" rel="noopener" title="curtis-compliance">
        <span class="cs-sd-cap">CC</span>
        <span class="cs-sd-label">curtis-co</span>
      </a>
      <a class="cs-sd-key cs-sd-green" href="https://jordannewell.github.io/crypto-key-classifier/" target="_blank" rel="noopener" title="crypto-key-classifier">
        <span class="cs-sd-cap">K</span>
        <span class="cs-sd-label">crypto-key</span>
      </a>
      <a class="cs-sd-key cs-sd-white" href="https://jordannewell.github.io/temporal-git/" target="_blank" rel="noopener" title="temporal-git">
        <span class="cs-sd-cap">T</span>
        <span class="cs-sd-label">temporal</span>
      </a>
      <a class="cs-sd-key cs-sd-white" href="https://jordannewell.github.io/git-hygiene/" target="_blank" rel="noopener" title="git-hygiene">
        <span class="cs-sd-cap">G</span>
        <span class="cs-sd-label">git-hygiene</span>
      </a>
      <a class="cs-sd-key cs-sd-green" href="https://jordannewell.github.io/newell-typeface/" target="_blank" rel="noopener" title="newell-typeface">
        <span class="cs-sd-cap">N</span>
        <span class="cs-sd-label">typeface</span>
      </a>
      <a class="cs-sd-key cs-sd-white" href="https://jordannewell.github.io/pat-scanner/" target="_blank" rel="noopener" title="pat-scanner">
        <span class="cs-sd-cap">P</span>
        <span class="cs-sd-label">pat-scan</span>
      </a>
      </div>
    </div>
  </div>
  <EmojiDock />
</section>
<script src="/js/status-hero.js?v=5" defer></script>

<style is:global>
  @font-face {
    font-family: "Newell";
    src: url("/fonts/Newell-Regular.woff2") format("woff2");
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }
</style>

<style is:global>
  body { background-color: #000; }
  .dot-grid { display: none; }
  main { padding-top: 10px !important; padding-bottom: 0 !important; max-width: none !important; }
  /* Lock scroll on desktop only — mobile needs to scroll to reach the dock. */
  @media (min-width: 769px) {
    html, body { height: 100%; overflow: hidden; }
  }
</style>

<style>
  .cs {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 10px;
    padding: 0 0 0;
    /* Fit fully inside viewport on desktop. Header (~60px) + main padding (~28px)
       leave ~calc(100vh - 90px) for splash content. Body overflow:hidden backs this up. */
    min-height: calc(100vh - 90px);
  }
  .cs :global([data-terminal]) {
    margin-top: 0;
  }
  .cs-keyboard-stage {
    width: 100%;
    max-width: 720px; /* match terminal width so the two read as proportional siblings */
    margin-top: 0;
    position: relative;
    perspective: 1500px;
    perspective-origin: 50% 20%;
  }
  .cs-keyboard {
    width: 100%;
    display: flex;
    justify-content: center;
    position: relative;
    z-index: 2;
    transform: rotateX(10deg) scale(0.92);
    transform-origin: center 80%;
    transition: transform 0.35s cubic-bezier(0.2, 0.9, 0.4, 1.2),
                filter 0.35s ease;
    filter: drop-shadow(0 18px 18px rgba(0, 0, 0, 0.75));
  }
  /* Stationary 3D pose — hover just magnifies, no tilt change. */
  .cs-keyboard-stage:hover .cs-keyboard {
    transform: rotateX(16deg) scale(1.04);
    filter: drop-shadow(0 28px 26px rgba(0, 0, 0, 0.8))
            drop-shadow(0 0 14px rgba(63, 255, 70, 0.12));
  }
  /* Desk surface — a tilted plane that recedes from foreground to background.
     Drawn as a CSS gradient: light hit near the keyboard, fading to deep shadow
     toward the back. Slight green tint near the keyboard's underglow. */
  .cs-desk {
    position: absolute;
    left: 50%;
    bottom: -10px;
    width: 110%;
    height: 80px;
    transform: translateX(-50%) perspective(600px) rotateX(60deg);
    transform-origin: center top;
    background:
      radial-gradient(ellipse at 50% 0%,
        rgba(63, 255, 70, 0.10) 0%,
        rgba(20, 20, 22, 0.6) 25%,
        rgba(8, 8, 10, 0.95) 60%,
        rgba(0, 0, 0, 1) 100%);
    z-index: 1;
    pointer-events: none;
  }
  /* Subtle desk grain via repeating gradient overlay */
  .cs-desk::before {
    content: "";
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      90deg,
      transparent 0px,
      transparent 2px,
      rgba(255, 255, 255, 0.012) 2px,
      rgba(255, 255, 255, 0.012) 3px
    );
  }
  /* Portrait standing free at bottom-right — no frame, no box, no border.
     Just the figure on the page. Static, no interaction. */
  .cs-pfp {
    position: fixed;
    right: -30px;
    bottom: -30px;
    width: 200px;
    height: auto;
    opacity: 0.7;
    filter: drop-shadow(0 8px 16px rgba(0, 0, 0, 0.55));
    pointer-events: none;
    z-index: 50;
  }
  .cs-pfp img {
    width: 100%;
    height: auto;
    display: block;
  }
  .cs-pfp:hover {
    opacity: 1;
    transform: translateY(-4px);
    filter: drop-shadow(0 14px 22px rgba(0, 0, 0, 0.7))
            drop-shadow(0 0 18px rgba(63, 255, 70, 0.25));
  }
  @media (max-width: 768px) {
    .cs-pfp { width: 160px; right: -20px; bottom: -20px; }
  }
  /* Curtis AI badge — visual sibling of the PFP, anchored bottom-left. */
  .cs-curtis {
    position: fixed;
    left: 28px;
    bottom: 0;
    width: 205px;
    height: auto;
    text-decoration: none;
    transition: transform 0.2s ease, filter 0.2s ease;
    z-index: 50;
    filter: drop-shadow(0 8px 16px rgba(0, 0, 0, 0.55));
  }
  .cs-curtis img {
    width: 100%;
    height: auto;
    display: block;
  }
  .cs-curtis:hover {
    transform: translateY(-4px);
    filter: drop-shadow(0 14px 22px rgba(0, 0, 0, 0.7))
            drop-shadow(0 0 18px rgba(63, 255, 70, 0.25));
  }
  @media (max-width: 768px) {
    .cs-curtis { width: 110px; left: 12px; bottom: 0; }
  }
  .cs-logo-wrap {
    width: 100%;
    max-width: 220px;
    display: block;
    pointer-events: none;
    user-select: none;
  }
  .cs-logo {
    width: 100%;
    height: auto;
    display: block;
  }
  @media (max-width: 480px) {
    .cs-logo-wrap { max-width: 220px; }
  }
  .cs-meta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }
  .cs-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-green);
    background: color-mix(in srgb, var(--color-green) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-green) 35%, transparent);
    padding: 4px 10px;
  }
  .cs-eyebrow-lg {
    font-size: 0.9rem;
    letter-spacing: 0.22em;
    padding: 6px 14px;
    gap: 10px;
    box-shadow: 0 0 24px color-mix(in srgb, var(--color-green) 18%, transparent);
  }
  .cs-eyebrow-lg .cs-pulse {
    width: 8px;
    height: 8px;
  }
  .cs-pulse {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-green);
    box-shadow: 0 0 8px var(--color-green);
    animation: cs-blink 2s ease-in-out infinite;
  }
  @keyframes cs-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }
  .cs-stamp {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-fg-muted);
    margin: 0;
  }
  /* Tiny status line anchoring the top of the page — no full header. */
  .cs-status-line {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-fg-muted);
    opacity: 0.5;
    text-align: center;
    margin-bottom: 4px;
  }

  /* Premium mechanical key-caps — matte PBT, black inner cap, colored frame + legend.
     Two variants alternate: green-frame (white legend) and white-frame (green legend).
     Inspired by GMK/SP profiles, not cheap ABS toys — sharp edges, subtle bevel,
     minimal depth, no glossy highlights. */
  .cs-key {
    position: fixed;
    top: var(--k-top, auto);
    right: var(--k-right, auto);
    left: var(--k-left, auto);
    transform: rotate(var(--k-rot, 0deg));
    transform-origin: center;
    width: 46px;
    height: 46px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    border-radius: 5px;
    transition: transform 0.14s cubic-bezier(0.2, 0.9, 0.4, 1.2),
                opacity 0.18s ease;
    opacity: 0.45;
    z-index: 5;
    user-select: none;
  }
  .cs-key:hover {
    opacity: 1;
  }
  /* Inner cap = black for both variants (PBT-style matte top) */
  .cs-key-cap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 3px;
    background: #0a0a0a;
    font-family: "Newell", var(--font-mono);
    font-size: 1.25rem;
    line-height: 1;
    letter-spacing: -0.02em;
    transition: background 0.14s, color 0.14s;
  }
  /* Variant A: green frame, white legend */
  .cs-key-green {
    background: #0a0a0a; /* thin black ring */
    box-shadow:
      0 0 0 1.5px #3FFF46,           /* outer rim = neon green frame */
      0 1px 0 #3FFF46,                /* subtle lift */
      0 3px 5px rgba(0, 0, 0, 0.6),
      0 0 12px rgba(63, 255, 70, 0.15);
  }
  .cs-key-green .cs-key-cap {
    color: #fff;
    box-shadow: inset 0 0 0 1px #1a1a1a; /* hairline inner edge */
  }
  /* Variant B: white frame, green legend */
  .cs-key-white {
    background: #0a0a0a;
    box-shadow:
      0 0 0 1.5px #fafafa,             /* outer rim = off-white frame */
      0 1px 0 #fafafa,
      0 3px 5px rgba(0, 0, 0, 0.6),
      0 0 12px rgba(255, 255, 255, 0.08);
  }
  .cs-key-white .cs-key-cap {
    color: #3FFF46;
    box-shadow: inset 0 0 0 1px #1a1a1a;
  }
  /* Hover: tiny lift, frame brightens */
  .cs-key:hover {
    transform: rotate(var(--k-rot, 0deg)) translateY(-2px) scale(1.06);
  }
  .cs-key-green:hover {
    box-shadow:
      0 0 0 1.5px #5fff66,
      0 3px 0 #3FFF46,
      0 6px 10px rgba(0, 0, 0, 0.7),
      0 0 22px rgba(63, 255, 70, 0.4);
  }
  .cs-key-white:hover {
    box-shadow:
      0 0 0 1.5px #ffffff,
      0 3px 0 #fafafa,
      0 6px 10px rgba(0, 0, 0, 0.7),
      0 0 22px rgba(255, 255, 255, 0.18);
  }
  /* Press: sink, no lift */
  .cs-key:active {
    transform: rotate(var(--k-rot, 0deg)) translateY(1px) scale(0.97);
  }
  .cs-key-green:active {
    box-shadow:
      0 0 0 1.5px #3FFF46,
      0 1px 0 #29a62e,
      0 2px 3px rgba(0, 0, 0, 0.5),
      0 0 8px rgba(63, 255, 70, 0.1);
  }
  .cs-key-white:active {
    box-shadow:
      0 0 0 1.5px #fafafa,
      0 1px 0 #c0c0c0,
      0 2px 3px rgba(0, 0, 0, 0.5);
  }
  /* Hide on phones — scattered fixed keys clutter a 375px viewport.
     The horizontal .cs-key-strip below replaces them on mobile. */
  @media (max-width: 768px) {
    .cs-key { display: none; }
  }
  /* Tighter keys on tablets so they don't crowd centered content */
  @media (min-width: 769px) and (max-width: 1100px) {
    .cs-key { width: 38px; height: 38px; }
    .cs-key-cap { width: 30px; height: 30px; font-size: 1rem; }
  }

  /* Mobile-only key strip — JORDAN row + NEWELL row, centered */
  .cs-key-strip {
    display: none; /* hidden on desktop, scattered fixed keys take over */
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 4px 2px 8px;
  }
  .cs-strip-word {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .cs-strip-key {
    flex: 0 0 auto;
    width: 34px;
    height: 34px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    border-radius: 5px;
    background: #0a0a0a;
    transition: transform 0.18s cubic-bezier(0.34, 1.56, 0.64, 1),
                box-shadow 0.18s ease;
  }
  .cs-strip-key:hover,
  .cs-strip-key:active {
    transform: scale(1.18);
    z-index: 2;
  }
  .cs-strip-key.cs-key-green:hover,
  .cs-strip-key.cs-key-green:active {
    box-shadow: 0 0 0 1.2px #3FFF46, 0 1px 2px rgba(0,0,0,0.5), 0 0 14px rgba(63,255,70,0.4);
  }
  .cs-strip-key.cs-key-white:hover,
  .cs-strip-key.cs-key-white:active {
    box-shadow: 0 0 0 1.2px #fafafa, 0 1px 2px rgba(0,0,0,0.5), 0 0 14px rgba(255,255,255,0.25);
  }
  .cs-strip-cap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: 3px;
    background: #0a0a0a;
    font-family: "Newell", var(--font-mono);
    font-size: 0.95rem;
    line-height: 1;
  }
  /* Same variant styling as fixed keys but with thinner rims for small sizes */
  .cs-strip-key.cs-key-green {
    box-shadow: 0 0 0 1.2px #3FFF46, 0 1px 2px rgba(0,0,0,0.5), 0 0 8px rgba(63,255,70,0.15);
  }
  .cs-strip-key.cs-key-green .cs-strip-cap { color: #fff; }
  .cs-strip-key.cs-key-white {
    box-shadow: 0 0 0 1.2px #fafafa, 0 1px 2px rgba(0,0,0,0.5);
  }
  .cs-strip-key.cs-key-white .cs-strip-cap { color: #3FFF46; }
  /* :active subsumed by the :hover/:active block above — both enlarge now. */
  @media (max-width: 768px) {
    .cs-key-strip {
      display: flex;
      width: 100%;
      margin-top: 10px;
    }
  }

  /* "Newell font →" — rendered in the Newell typeface itself.
     Mobile copy lives inside .cs-key-strip (under the letters).
     Desktop copy is a separate element under the keyboard. */
  .cs-typelink {
    font-family: "Newell", var(--font-mono);
    font-size: 0.95rem;
    letter-spacing: -0.01em;
    color: var(--color-fg-muted);
    text-decoration: none;
    border-bottom: 1px dotted color-mix(in srgb, #3FFF46 35%, transparent);
    transition: color 0.15s, border-color 0.15s;
    margin-top: 10px;
    padding-bottom: 1px;
  }
  .cs-typelink-desktop {
    display: inline-flex;
    margin-top: 10px;
  }
  .cs-typelink:hover {
    color: #3FFF46;
    border-bottom-color: #3FFF46;
  }
  .cs-typelink span[aria-hidden] {
    display: inline-block;
    margin-left: 4px;
    transition: transform 0.15s;
  }
  .cs-typelink:hover span[aria-hidden] {
    transform: translateX(2px);
  }
</style>

<style is:global>
  .cs-streamdeck {
    width: 180px;
    margin: 0 auto;
    perspective: 1200px;
    perspective-origin: 50% 20%;
  }
  .cs-sd-bezel {
    background: #060606;
    border-radius: 8px;
    padding: 10px;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.03), 0 0 0 1px #1A1A1A, 0 3px 0 #0D0D0D, 0 8px 16px rgba(0,0,0,0.7);
    transform: rotateX(8deg) scale(0.9);
    transform-origin: center 80%;
