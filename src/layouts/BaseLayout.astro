---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SchemaOrg from "../components/SchemaOrg.astro";
import { SITE } from "../lib/site";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  schema?: object[];
  path?: string;
  ogImage?: string;
  favicon?: string;
  bare?: boolean;
}

const {
  title = SITE.title,
  description = SITE.description,
  schema = [],
  path = Astro.url.pathname,
  ogImage,
  favicon = "/favicon.svg",
  bare = false,
} = Astro.props;

const ogTitle = title === SITE.title ? title : `${title} — ${SITE.title}`;
const resolvedOgImage = ogImage
  ? (ogImage.startsWith("http") ? ogImage : `${SITE.url}${ogImage}`)
  : `${SITE.url}/og-card.png`;
const resolvedFavicon = favicon.startsWith("http") ? favicon : `${SITE.url}${favicon}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{ogTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=2" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512.png?v=2" />
    <link rel="apple-touch-icon" href="/favicon-512.png?v=2" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={resolvedOgImage} />
    <link rel="license" href="https://creativecommons.org/licenses/by-nc/4.0/" />
    <meta name="copyright" content="© 2026 Jordan Newell. CC BY-NC 4.0." />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <link rel="alternate" type="application/json" title={SITE.title} href="/feed.json" />
    <SchemaOrg schema={schema} />
    <!-- Cloudflare Web Analytics -->
    <script type='module' src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "012b8a7bc7594c91aff6f05cab5951fd"}'></script>
  </head>
  <body>
    <div class="dot-grid"></div>
    <div class="relative z-1">
      {!bare && <Header path={path} />}
      <main class="max-w-prose mx-auto px-5 py-12">
        <slot />
      </main>
      {!bare && <Footer />}
    </div>
    <script src="/js/main.js" defer></script>
  <!--
  NEWELL Universal Footer — drop-in component.
  Paste before </body> on any page. Self-contained: inline CSS + SVG, no deps.
-->
<footer class="newell-footer">
  <a href="https://jordannewell.com" class="newell-footer-link" aria-label="A NEWELL project — visit jordannewell.com" title="A NEWELL project">
    <svg class="newell-footer-mark" viewBox="0 0 48 48" width="24" height="24" aria-hidden="true">
      <rect x="2" y="2" width="44" height="44" rx="6" fill="#0A0A0A" stroke="#00FF41" stroke-width="1.5"/>
      <rect x="6" y="6" width="36" height="36" rx="3" fill="#0A0A0A" stroke="#1F1F1F" stroke-width="0.5"/>
      <path d="M 14 14 L 14 34 L 17 34 L 17 19 L 14 16 Z" fill="#FFFFFF"/>
      <path d="M 31 34 L 31 31 L 17 14 L 14 14 L 14 17 L 28 34 Z" fill="#FFFFFF"/>
      <path d="M 34 14 L 31 14 L 31 31 L 34 28 L 34 14 Z" fill="#FFFFFF"/>
    </svg>
    <span class="newell-footer-text">
      <span class="newell-footer-project">A NEWELL project</span>
      <span class="newell-footer-sep">·</span>
      <span class="newell-footer-credit">Built by Jordan Newell</span>
    </span>
  </a>
</footer>

<style>
  .newell-footer {
    border-top: 1px solid #1F1F1F;
    background: #0A0A0A;
    padding: 14px 24px;
    font-family: "JetBrains Mono", "SF Mono", Menlo, monospace;
    font-size: 12px;
    letter-spacing: 0.04em;
    color: #A0A0A0;
    margin-top: auto;
  }
  .newell-footer-link {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: inherit;
    max-width: 1200px;
    margin: 0 auto;
    transition: color 0.15s ease;
  }
  .newell-footer-link:hover {
    color: #00FF41;
  }
  .newell-footer-mark {
    flex-shrink: 0;
    display: block;
  }
  .newell-footer-text {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .newell-footer-project {
    color: #FFFFFF;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 11px;
  }
  .newell-footer-sep {
    color: #1F1F1F;
  }
  .newell-footer-credit {
    color: #A0A0A0;
  }
  .newell-footer-link:hover .newell-footer-project {
    color: #00FF41;
  }
  @media (max-width: 600px) {
    .newell-footer {
      padding: 12px 16px;
      font-size: 11px;
    }
    .newell-footer-link {
      gap: 8px;
    }
    .newell-footer-mark {
      width: 20px;
      height: 20px;
    }
  }
</style>

</body>
</html>
