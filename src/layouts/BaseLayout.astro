---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SchemaOrg from "../components/SchemaOrg.astro";
import { SITE } from "../lib/site";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  schema?: object[];
  path?: string;
  ogImage?: string;
  favicon?: string;
  bare?: boolean;
}

const {
  title = SITE.title,
  description = SITE.description,
  schema = [],
  path = Astro.url.pathname,
  ogImage,
  favicon = "/favicon.svg",
  bare = false,
} = Astro.props;

const ogTitle = title === SITE.title ? title : `${title} — ${SITE.title}`;
const resolvedOgImage = ogImage
  ? (ogImage.startsWith("http") ? ogImage : `${SITE.url}${ogImage}`)
  : `${SITE.url}/og-card.png`;
const resolvedFavicon = favicon.startsWith("http") ? favicon : `${SITE.url}${favicon}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{ogTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=2" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512.png?v=2" />
    <link rel="apple-touch-icon" href="/favicon-512.png?v=2" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={resolvedOgImage} />
    <link rel="license" href="https://creativecommons.org/licenses/by-nc/4.0/" />
    <meta name="copyright" content="© 2026 Jordan Newell. CC BY-NC 4.0." />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <link rel="alternate" type="application/json" title={SITE.title} href="/feed.json" />
    <SchemaOrg schema={schema} />
    <!-- Cloudflare Web Analytics -->
    <script type='module' src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "012b8a7bc7594c91aff6f05cab5951fd"}'></script>
  </head>
  <body>
    <div class="dot-grid"></div>
    <div class="relative z-1">
      {!bare && <Header path={path} />}
      <main class="max-w-prose mx-auto px-5 py-12">
        <slot />
      </main>
      {!bare && <Footer />}
    </div>
    <script src="/js/main.js" defer></script>
  {bare && (
  <footer class="newell-site-footer">
  <div class="nsf-inner">
    <div class="nsf-brand">
      <svg class="nsf-mark" viewBox="0 0 48 48" width="28" height="28" aria-hidden="true">
        <rect x="2" y="2" width="44" height="44" rx="6" fill="#0A0A0A" stroke="#00FF41" stroke-width="1.5"/>
        <rect x="6" y="6" width="36" height="36" rx="3" fill="#0A0A0A" stroke="#1F1F1F" stroke-width="0.5"/>
        <path d="M 14 14 L 14 34 L 17 34 L 17 19 L 14 16 Z" fill="#FFFFFF"/>
        <path d="M 31 34 L 31 31 L 17 14 L 14 14 L 14 17 L 28 34 Z" fill="#FFFFFF"/>
        <path d="M 34 14 L 31 14 L 31 31 L 34 28 L 34 14 Z" fill="#FFFFFF"/>
      </svg>
      <div class="nsf-brand-text">
        <a href="https://jordannewell.com" class="nsf-brand-link">NEWELL</a>
        <span class="nsf-sep">·</span>
        <span class="nsf-product">Build · Connect · Grow</span>
      </div>
    </div>
    <div class="nsf-row nsf-links">
      <a href="https://github.com/JordanNewell">github</a> <span class="nsf-sep">·</span>
      <a href="https://jordannewell.com/posts/">blog</a> <span class="nsf-sep">·</span>
      <a href="https://jordannewell.com/today/">today</a> <span class="nsf-sep">·</span>
      <a href="https://status.jordannewell.com">status</a> <span class="nsf-sep">·</span>
      <a href="https://github.com/JordanNewell/JordanNewell/blob/main/README.md">readme</a>
    </div>
    <div class="nsf-row nsf-meta">
      <span>Personal</span> <span class="nsf-sep">·</span>
      <span>Engineer-built</span> <span class="nsf-sep">·</span>
      <span>Self-hosted</span> <span class="nsf-sep">·</span>
      <span>Tampa Bay</span>
    </div>
    <div class="nsf-row nsf-family">
      <span class="nsf-family-label">projects:</span>
      <a href="https://jordannewell.github.io/harbormasterd/">harbormasterd</a> <span class="nsf-sep">·</span> <a href="https://jordannewell.github.io/claudeway-site/">claudeway</a> <span class="nsf-sep">·</span> <a href="https://github.com/JordanNewell/curtis-ai-chat">curtis-ai-chat</a> <span class="nsf-sep">·</span> <a href="https://jordannewell.github.io/curtis-compliance/">curtis-compliance</a> <span class="nsf-sep">·</span> <a href="https://jordannewell.github.io/crypto-key-classifier/">crypto-key-classifier</a> <span class="nsf-sep">·</span> <a href="https://jordannewell.github.io/git-hygiene/">git-hygiene</a> <span class="nsf-sep">·</span> <a href="https://jordannewell.github.io/newell-typeface/">newell-typeface</a> <span class="nsf-sep">·</span> <a href="https://jordannewell.github.io/pat-scanner/">pat-scanner</a> <span class="nsf-sep">·</span> <a href="https://jordannewell.github.io/temporal-git/">temporal-git</a>
    </div>
    <div class="nsf-row nsf-legal">© 2026 Jordan Newell · NEWELL is a trademark of Jordan Newell · All products MIT or OFL-1.1</div>
    <div class="nsf-row nsf-social">
      <a href="https://github.com/JordanNewell">github</a> <span class="nsf-sep">·</span>
      <a href="https://github.com/sponsors/JordanNewell">sponsor</a> <span class="nsf-sep">·</span>
      <a href="https://buymeacoffee.com/jordannewell">coffee →</a>
    </div>
  </div>
</footer>
  )}
<style is:global>
.newell-site-footer { border-top: 1px solid #1F1F1F; background: #0A0A0A; padding: 24px; font-family: "JetBrains Mono", "SF Mono", Menlo, monospace; font-size: 12px; color: #A0A0A0; }
.nsf-inner { max-width: 1200px; margin: 0 auto; display: flex; flex-direction: column; gap: 8px; }
.nsf-brand { display: flex; align-items: center; gap: 12px; margin-bottom: 4px; }
.nsf-mark { flex-shrink: 0; display: block; }
.nsf-brand-text { display: inline-flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.nsf-brand-link { color: #FFFFFF; text-decoration: none; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; font-size: 11px; transition: color 0.15s ease; }
.nsf-brand-link:hover { color: #00FF41; }
.nsf-product { color: #00FF41; font-weight: 500; }
.nsf-sep { color: #1F1F1F; }
.nsf-row { padding-left: 40px; }
.nsf-links a, .nsf-meta span, .nsf-legal { color: #A0A0A0; }
.nsf-links a { text-decoration: none; transition: color 0.15s ease; }
.nsf-links a:hover { color: #00FF41; }
.nsf-meta span { color: #707070; }
.nsf-legal { color: #707070; font-size: 11px; line-height: 1.5; }
.nsf-family { display: flex; flex-wrap: wrap; align-items: center; gap: 4px; }
.nsf-family-label { color: #707070; text-transform: uppercase; letter-spacing: 0.1em; font-size: 10px; margin-right: 4px; }
.nsf-family a { color: #707070; text-decoration: none; transition: color 0.15s ease; }
.nsf-family a:hover { color: #00FF41; }
.nsf-social { padding-left: 40px; margin-top: 4px; }
.nsf-social a { color: #A0A0A0; text-decoration: none; transition: color 0.15s ease; }
.nsf-social a:hover { color: #00FF41; }
@media (max-width: 600px) {
  .newell-site-footer { padding: 16px; font-size: 11px; }
  .nsf-row, .nsf-social { padding-left: 0; }
}
</style>
</body>
</html>
